{
  "name": "cf-pastebin",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:client": "vite build",
    "build:worker": "esbuild src/worker/index.ts --bundle --target=es2022 --format=esm --outfile=dist-worker/index.js \"--external:cloudflare:*\"",
    "build": "bun run build:client",
    "deploy": "wrangler deploy",
    "preview": "wrangler dev",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "@solidjs/router": "^0.15.3",
    "lucide-solid": "^1.2.0",
    "solid-js": "^1.9.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250224.0",
    "@types/node": "^26.6.3",
    "autoprefixer": "^10.4.20",
    "esbuild": "^0.25.0",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^8.3.2",
    "vite-plugin-solid": "^2.11.6",
    "wrangler": "^4.141.0"
  }
}
